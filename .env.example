# Backup Scheduling (cron format, default: daily at 03:00 UTC)
BACKUP_SCHEDULE_CRON=0 3 * * *

# Backup Log File Location (default: /var/log/s3-backup/backup.log)
BACKUP_LOG_FILE=/var/log/s3-backup/backup.log

# Bucket Configuration (one or more buckets)
# Format: BACKUP_BUCKET_<N>_NAME=<bucket-name>
#         BACKUP_BUCKET_<N>_DEST=<local-destination-path>
# Example with 2 buckets:
BACKUP_BUCKET_1_NAME=my-bucket-1
BACKUP_BUCKET_1_DEST=/backup/bucket1

BACKUP_BUCKET_2_NAME=my-bucket-2
BACKUP_BUCKET_2_DEST=/backup/bucket2
